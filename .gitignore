# .gitignore for BloggingApp (ASP.NET Core + Razor Pages + Node + Docker)

# --- Visual Studio / .NET ---
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Build outputs
**/bin/
**/obj/
**/publish/
*.ilk
*.pdb

# NuGet
*.nupkg
packages/
.nuget/

# Test results / coverage
TestResults/
*.trx
*.coverage
coverage/

# --- IDEs ---
# Rider / JetBrains
.idea/
*.iml

# VS Code
.vscode/

# --- Node / client ---
node_modules/
wwwroot/lib/
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- Logs & temp ---
*.log
logs/
*.tmp
*.temp
*.pid
*.sublime-workspace

# --- OS ---
.DS_Store
Thumbs.db

# --- Database ---
# Ignore sqlite databases and temporary sqlite files
*.db
*.db-shm
*.db-wal
# If you intentionally want to commit the DB, remove these lines and run `git rm --cached` as needed.

# Keep EF Migrations source files (they are part of source)
!BloggingApp.Api/Migrations/
!BloggingApp.Api/Migrations/*.cs
!BloggingApp.Api/Migrations/*.Designer.cs

# --- Secrets / Environment ---
.env
.env.*.local
.env.local
secrets.json
# Keep example env file in repo
!.env.example

# --- Docker / Compose ---
docker-compose.override.yml

# --- Misc ---
*.sublime-project

# Allow explicit files if needed (examples)
# !/path/to/file

# Domain Configuration
DOMAIN_NAME=yourdomain.com
API_SUBDOMAIN=api
WEB_SUBDOMAIN=www

# API URL (used by RazorPages to communicate with API)
API_BASE_URL=http://api:8080

# Database Configuration
DATABASE_PATH=/app/data/blogging.db

# JWT Configuration (Change these in production!)
JWT_KEY=your-super-secret-key-change-in-production-min-32-chars-please-make-it-secure
JWT_ISSUER=BloggingApp.Api
JWT_AUDIENCE=BloggingApp.Web

# Owner Account (First user created)
OWNER_EMAIL=admin@yourdomain.com
OWNER_PASSWORD=ChangeThisPassword123!

# CORS Allowed Origins (comma-separated)
# These should match your actual domain names
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://web,http://web:8081

# Application Settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Logging
LOG_LEVEL=Information
ASPNETCORE_LOG_LEVEL=Warning


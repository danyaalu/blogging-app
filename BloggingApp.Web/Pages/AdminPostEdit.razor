@page "/admin/posts/{id:guid}/edit"
@using BloggingApp.Web.Services
@using BloggingApp.Web.Models
@inject IPostService PostService
@inject IAuthService AuthService
@inject ISlugService SlugService
@inject NavigationManager Navigation

<PageTitle>Edit Post - Admin</PageTitle>

<div class="container py-5">
    <h1 class="mb-4">Edit Post</h1>

    @if (loading)
    {
        <p><em>Loading post...</em></p>
    }
    else if (post == null)
    {
        <div class="alert alert-danger">Post not found.</div>
        <a href="/admin/posts" class="btn btn-secondary">Back to Posts</a>
    }
    else
    {
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <form @onsubmit="HandleSubmit">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" class="form-control" id="title" @bind="title" required maxlength="200" />
            </div>

            <div class="mb-3">
                <label for="slug" class="form-label">Slug</label>
                <input type="text" class="form-control" id="slug" @bind="slug" required maxlength="200" />
                <small class="form-text text-muted">URL-friendly version of the title (lowercase, hyphens)</small>
            </div>

            <div class="mb-3">
                <label for="summary" class="form-label">Summary (Optional)</label>
                <textarea class="form-control" id="summary" @bind="summary" rows="2" maxlength="300"></textarea>
            </div>

            <div class="mb-3">
                <label for="bodyMarkdown" class="form-label">Body (Markdown)</label>
                <textarea class="form-control" id="bodyMarkdown" @bind="bodyMarkdown" rows="15" required></textarea>
            </div>

            <div class="mb-3">
                <label for="status" class="form-label">Status</label>
                <select class="form-select" id="status" @bind="status">
                    <option value="Draft">Draft</option>
                    <option value="Published">Published</option>
                </select>
            </div>

            @if (post.PublishedAt.HasValue)
            {
                <div class="mb-3">
                    <small class="text-muted">Published: @post.PublishedAt.Value.ToLocalTime().ToString("MMMM dd, yyyy HH:mm")</small>
                </div>
            }

            <div class="mb-3">
                <button type="submit" class="btn btn-primary" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span>Updating...</span>
                    }
                    else
                    {
                        <span>Update Post</span>
                    }
                </button>
                <a href="/admin/posts" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private PostAdminDto? post;
    private string title = string.Empty;
    private string slug = string.Empty;
    private string? summary = null;
    private string bodyMarkdown = string.Empty;
    private string status = "Draft";
    private string errorMessage = string.Empty;
    private bool loading = true;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadPost();
    }

    private async Task LoadPost()
    {
        loading = true;
        var posts = await PostService.GetAdminPostsAsync();
        post = posts.FirstOrDefault(p => p.Id == Id);

        if (post != null)
        {
            title = post.Title;
            slug = post.Slug;
            summary = post.Summary;
            bodyMarkdown = post.BodyMarkdown;
            status = post.Status;
        }

        loading = false;
    }

    private async Task HandleSubmit()
    {
        isLoading = true;
        errorMessage = string.Empty;

        var request = new UpdatePostRequest(title, slug, summary, bodyMarkdown, status);
        var result = await PostService.UpdatePostAsync(Id, request);

        if (result != null)
        {
            Navigation.NavigateTo("/admin/posts");
        }
        else
        {
            errorMessage = "Failed to update post. Please check your inputs.";
        }

        isLoading = false;
    }
}

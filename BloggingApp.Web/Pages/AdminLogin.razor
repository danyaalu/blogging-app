@page "/admin/login"
@using BloggingApp.Web.Services
@using BloggingApp.Web.Models
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Login - Admin</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h1 class="h3 mb-4 text-center">Owner Login</h1>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> @errorMessage
                        </div>
                    }

                    <form @onsubmit="HandleLogin">
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" 
                                   class="form-control" 
                                   id="email" 
                                   @bind="email" 
                                   placeholder="owner@danyaal.net"
                                   required 
                                   autofocus />
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Password</label>
                            <input type="password" 
                                   class="form-control" 
                                   id="password" 
                                   @bind="password" 
                                   placeholder="Enter your password"
                                   required />
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Logging in...</span>
                                }
                                else
                                {
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    <span>Login</span>
                                }
                            </button>
                        </div>
                    </form>

                    <hr class="my-4" />
                    
                    <div class="text-center text-muted small">
                        <p class="mb-1">Default credentials for demo:</p>
                        <p class="mb-0"><strong>Email:</strong> owner@danyaal.net</p>
                        <p class="mb-0"><strong>Password:</strong> Owner123!</p>
                    </div>
                </div>
            </div>
            
            <div class="text-center mt-3">
                <a href="/" class="text-muted">
                    <i class="bi bi-arrow-left"></i> Back to Home
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string errorMessage = string.Empty;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var request = new LoginRequest(email, password);
            var response = await AuthService.LoginAsync(request);

            if (response != null)
            {
                // Login successful - navigate to admin dashboard
                Navigation.NavigateTo("/admin/posts", forceLoad: true);
            }
            else
            {
                errorMessage = "Invalid email or password. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Login failed: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}


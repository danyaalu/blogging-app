@page "/admin/posts"
@using BloggingApp.Web.Services
@using BloggingApp.Web.Models
@inject IPostService PostService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Manage Posts - Admin</PageTitle>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 style="font-size: 2rem; font-weight: 300; margin: 0;"><i class="bi bi-newspaper"></i> Manage Posts</h1>
        <div>
            <a href="/admin/posts/new" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> New Post
            </a>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status" style="color: #60a5fa;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3" style="color: #9ca3af;">Loading posts...</p>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-4">
                <select class="form-select" @onchange="OnStatusFilterChange" style="background-color: #0a0a0a; border-color: #1f2937; color: #e0e0e0;">
                    <option value="">All Posts (@posts.Count)</option>
                    <option value="Draft">Drafts Only</option>
                    <option value="Published">Published Only</option>
                </select>
            </div>
        </div>

        @if (!posts.Any())
        {
            <div class="alert alert-info" style="background-color: #1e3a5f; border-color: #2563eb; color: #93c5fd;">
                <i class="bi bi-info-circle"></i> No posts found. Click "New Post" to create your first blog post!
            </div>
        }
        else
        {
            <div class="card" style="background-color: #000000; border: 1px solid #1f2937; border-radius: 12px;">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" style="color: #e0e0e0;">
                        <thead>
                            <tr style="border-bottom: 2px solid #374151;">
                                <th style="color: #9ca3af; font-weight: 400; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; padding: 1rem;">Title</th>
                                <th style="color: #9ca3af; font-weight: 400; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; padding: 1rem;">Slug</th>
                                <th style="color: #9ca3af; font-weight: 400; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; padding: 1rem;">Status</th>
                                <th style="color: #9ca3af; font-weight: 400; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; padding: 1rem;">Updated</th>
                                <th style="color: #9ca3af; font-weight: 400; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; padding: 1rem;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var post in posts)
                            {
                                <tr style="border-bottom: 1px solid #1f2937;">
                                    <td style="padding: 1rem;">
                                        <strong style="color: #ffffff;">@post.Title</strong>
                                        @if (!string.IsNullOrEmpty(post.Summary))
                                        {
                                            <br />
                                            <small class="text-muted" style="color: #6b7280;">@post.Summary</small>
                                        }
                                    </td>
                                    <td style="padding: 1rem;"><code style="background-color: #0a0a0a; border: 1px solid #1f2937; padding: 0.2rem 0.5rem; border-radius: 4px; color: #60a5fa;">@post.Slug</code></td>
                                    <td style="padding: 1rem;">
                                        <span class="badge @(post.Status == "Published" ? "bg-success" : "bg-secondary")">
                                            @post.Status
                                        </span>
                                    </td>
                                    <td style="padding: 1rem; color: #9ca3af;">@post.UpdatedAt.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                    <td style="padding: 1rem;">
                                        <a href="/admin/posts/@post.Id/edit" class="btn btn-sm btn-primary" style="background-color: #60a5fa; border-color: #60a5fa; color: #000000;">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <button class="btn btn-sm btn-danger ms-1" @onclick="() => DeletePost(post.Id)">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<PostAdminDto> posts = new();
    private bool loading = true;
    private string? statusFilter = null;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/admin/login");
            return;
        }

        await LoadPosts();
    }

    private async Task LoadPosts()
    {
        loading = true;
        posts = await PostService.GetAdminPostsAsync(statusFilter);
        loading = false;
    }

    private async Task OnStatusFilterChange(ChangeEventArgs e)
    {
        statusFilter = e.Value?.ToString();
        if (string.IsNullOrEmpty(statusFilter))
        {
            statusFilter = null;
        }
        await LoadPosts();
    }

    private async Task DeletePost(Guid id)
    {
        // Simple confirmation (in production, use a modal)
        var post = posts.FirstOrDefault(p => p.Id == id);
        if (post != null)
        {
            // Note: JavaScript confirm would need JS interop, so we'll just delete for now
            var success = await PostService.DeletePostAsync(id);
            if (success)
            {
                await LoadPosts();
            }
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/", forceLoad: true);
    }
}

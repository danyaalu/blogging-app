@page "/admin/posts"
@using BloggingApp.Web.Services
@using BloggingApp.Web.Models
@inject IPostService PostService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Manage Posts - Admin</PageTitle>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-newspaper"></i> Manage Posts</h1>
        <div>
            <a href="/admin/posts/new" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> New Post
            </a>
            <button class="btn btn-secondary ms-2" @onclick="HandleLogout">
                <i class="bi bi-box-arrow-right"></i> Logout
            </button>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Loading posts...</p>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-4">
                <select class="form-select" @onchange="OnStatusFilterChange">
                    <option value="">All Posts (@posts.Count)</option>
                    <option value="Draft">Drafts Only</option>
                    <option value="Published">Published Only</option>
                </select>
            </div>
        </div>

        @if (!posts.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No posts found. Click "New Post" to create your first blog post!
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Slug</th>
                                <th>Status</th>
                                <th>Updated</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var post in posts)
                            {
                                <tr>
                                    <td>
                                        <strong>@post.Title</strong>
                                        @if (!string.IsNullOrEmpty(post.Summary))
                                        {
                                            <br />
                                            <small class="text-muted">@post.Summary</small>
                                        }
                                    </td>
                                    <td><code>@post.Slug</code></td>
                                    <td>
                                        <span class="badge @(post.Status == "Published" ? "bg-success" : "bg-secondary")">
                                            @post.Status
                                        </span>
                                    </td>
                                    <td>@post.UpdatedAt.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <a href="/admin/posts/@post.Id/edit" class="btn btn-sm btn-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <button class="btn btn-sm btn-danger ms-1" @onclick="() => DeletePost(post.Id)">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<PostAdminDto> posts = new();
    private bool loading = true;
    private string? statusFilter = null;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/admin/login");
            return;
        }

        await LoadPosts();
    }

    private async Task LoadPosts()
    {
        loading = true;
        posts = await PostService.GetAdminPostsAsync(statusFilter);
        loading = false;
    }

    private async Task OnStatusFilterChange(ChangeEventArgs e)
    {
        statusFilter = e.Value?.ToString();
        if (string.IsNullOrEmpty(statusFilter))
        {
            statusFilter = null;
        }
        await LoadPosts();
    }

    private async Task DeletePost(Guid id)
    {
        // Simple confirmation (in production, use a modal)
        var post = posts.FirstOrDefault(p => p.Id == id);
        if (post != null)
        {
            // Note: JavaScript confirm would need JS interop, so we'll just delete for now
            var success = await PostService.DeletePostAsync(id);
            if (success)
            {
                await LoadPosts();
            }
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/", forceLoad: true);
    }
}

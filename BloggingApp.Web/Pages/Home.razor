@page "/"
@using BloggingApp.Web.Services
@using BloggingApp.Web.Models
@inject IPostService PostService
@inject NavigationManager Navigation

<PageTitle>Home - Danyaal's Blog</PageTitle>

<div class="container py-5">
    <h1 class="mb-4">Blog Posts</h1>

    @if (loading)
    {
        <p><em>Loading posts...</em></p>
    }
    else if (!posts.Any())
    {
        <p>No published posts yet.</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var post in posts)
            {
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h2 class="card-title h4">
                                <a href="/p/@post.Slug" class="text-decoration-none">@post.Title</a>
                            </h2>
                            @if (!string.IsNullOrEmpty(post.Summary))
                            {
                                <p class="card-text text-muted">@post.Summary</p>
                            }
                            <div class="text-muted small">
                                @if (post.PublishedAt.HasValue)
                                {
                                    <span>@post.PublishedAt.Value.ToLocalTime().ToString("MMMM dd, yyyy")</span>
                                }
                                <span class="ms-3">@post.ReadingMinutes min read</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<PostListDto> posts = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        posts = await PostService.GetPublishedPostsAsync(0, 20);
        loading = false;
    }
}

@page "/admin/posts/new"
@using BloggingApp.Web.Services
@using BloggingApp.Web.Models
@inject IPostService PostService
@inject IAuthService AuthService
@inject ISlugService SlugService
@inject NavigationManager Navigation

<PageTitle>New Post - Admin</PageTitle>

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1><i class="bi bi-file-earmark-plus"></i> Create New Post</h1>
                <a href="/admin/posts" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Posts
                </a>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-circle"></i> @errorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success" role="alert">
                    <i class="bi bi-check-circle"></i> @successMessage
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form @onsubmit="HandleSubmit">
                        <div class="mb-4">
                            <label for="title" class="form-label">Title <span class="text-danger">*</span></label>
                            <input type="text" 
                                   class="form-control form-control-lg" 
                                   id="title" 
                                   value="@title"
                                   @oninput="@((e) => { title = e.Value?.ToString() ?? string.Empty; GenerateSlug(); })"
                                   placeholder="Enter your post title"
                                   required 
                                   maxlength="200" />
                            <small class="text-muted">@title.Length / 200 characters</small>
                        </div>

                        <div class="mb-4">
                            <label for="slug" class="form-label">Slug <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">/p/</span>
                                <input type="text" 
                                       class="form-control" 
                                       id="slug" 
                                       @bind="slug" 
                                       placeholder="post-url-slug"
                                       required 
                                       maxlength="200" />
                            </div>
                            <small class="form-text text-muted">URL-friendly version (auto-generated from title)</small>
                        </div>

                        <div class="mb-4">
                            <label for="summary" class="form-label">Summary <span class="text-muted">(Optional)</span></label>
                            <textarea class="form-control" 
                                      id="summary" 
                                      @bind="summary" 
                                      rows="3" 
                                      placeholder="Brief description for the post listing"
                                      maxlength="300"></textarea>
                            <small class="text-muted">@(summary?.Length ?? 0) / 300 characters</small>
                        </div>

                        <div class="mb-4">
                            <label for="bodyMarkdown" class="form-label">Content (Markdown) <span class="text-danger">*</span></label>
                            <textarea class="form-control font-monospace" 
                                      id="bodyMarkdown" 
                                      @bind="bodyMarkdown" 
                                      rows="20" 
                                      placeholder="# Your Post Title&#10;&#10;Write your content here in Markdown...&#10;&#10;**Bold text**, *italic*, [links](url), etc."
                                      required></textarea>
                            <small class="text-muted">Supports Markdown formatting</small>
                        </div>

                        <div class="mb-4">
                            <label for="status" class="form-label">Status <span class="text-danger">*</span></label>
                            <select class="form-select" id="status" @bind="status">
                                <option value="Draft">Draft (not visible to public)</option>
                                <option value="Published">Published (visible to everyone)</option>
                            </select>
                        </div>

                        <hr class="my-4" />

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="/admin/posts" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-success btn-lg" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Creating...</span>
                                }
                                else
                                {
                                    <i class="bi bi-save"></i>
                                    <span>Create Post</span>
                                }
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string title = string.Empty;
    private string slug = string.Empty;
    private string? summary = null;
    private string bodyMarkdown = string.Empty;
    private string status = "Draft";
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/admin/login");
        }
    }

    private void GenerateSlug()
    {
        // Only auto-generate if slug is empty or hasn't been manually edited
        if (string.IsNullOrWhiteSpace(slug))
        {
            slug = SlugService.GenerateSlug(title);
        }
    }

    private async Task HandleSubmit()
    {
        isLoading = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            var request = new CreatePostRequest(title, slug, summary, bodyMarkdown, status);
            var result = await PostService.CreatePostAsync(request);

            if (result != null)
            {
                successMessage = "Post created successfully!";
                // Redirect after a short delay to show the success message
                await Task.Delay(1000);
                Navigation.NavigateTo("/admin/posts");
            }
            else
            {
                errorMessage = "Failed to create post. Please check your inputs and try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creating post: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}

@page "/admin/posts/new"
@using BloggingApp.Web.Services
@using BloggingApp.Web.Models
@inject IPostService PostService
@inject IAuthService AuthService
@inject ISlugService SlugService
@inject NavigationManager Navigation

<PageTitle>New Post - Admin</PageTitle>

<div class="container" style="padding-top: 3rem; padding-bottom: 3rem;">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 style="font-size: 2rem; font-weight: 300; margin: 0;">Create New Post</h1>
        <a href="/admin/posts" class="btn btn-outline-secondary" style="padding: 0.5rem 1rem;">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mb-4" role="alert">
            <i class="bi bi-exclamation-circle"></i> @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success mb-4" role="alert">
            <i class="bi bi-check-circle"></i> @successMessage
        </div>
    }

    <div class="card" style="border-radius: 16px; background-color: #000000; border: 1px solid #1a1a1a;">
        <div class="card-body" style="padding: 2.5rem;">
            <form @onsubmit="HandleSubmit">
                <div class="mb-4">
                    <label for="title" class="form-label">Title <span class="text-danger">*</span></label>
                    <input type="text" 
                           class="form-control form-control-lg" 
                           id="title" 
                           value="@title"
                           @oninput="OnTitleInput"
                           placeholder="Enter your post title"
                           required 
                           maxlength="200"
                           style="font-size: 1.25rem; padding: 0.75rem 1rem; background-color: #0a0a0a; border-color: #1f2937;" />
                    <small class="text-muted" style="font-size: 0.75rem;">@title.Length / 200</small>
                </div>

                <div class="mb-4">
                    <label for="slug" class="form-label">Slug <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: #0a0a0a; border-color: #1f2937; color: #6b7280;">/p/</span>
                        <input type="text" 
                               class="form-control" 
                               id="slug" 
                               value="@slug"
                               @oninput="OnSlugInput"
                               placeholder="post-url-slug"
                               required 
                               maxlength="200"
                               style="background-color: #0a0a0a; border-color: #1f2937;" />
                    </div>
                    <small class="form-text text-muted" style="font-size: 0.75rem;">URL-friendly version (auto-generated)</small>
                </div>

                <div class="mb-4">
                    <label for="summary" class="form-label">Summary <span class="text-muted" style="font-weight: 300;">(Optional)</span></label>
                    <textarea class="form-control" 
                              id="summary" 
                              @bind="summary" 
                              rows="3" 
                              placeholder="Brief description for the post listing"
                              maxlength="300"
                              style="background-color: #0a0a0a; border-color: #1f2937; font-family: inherit;"></textarea>
                    <small class="text-muted" style="font-size: 0.75rem;">@(summary?.Length ?? 0) / 300</small>
                </div>

                <div class="mb-4">
                    <label for="bodyMarkdown" class="form-label">Content (Markdown) <span class="text-danger">*</span></label>
                    <textarea class="form-control font-monospace" 
                              id="bodyMarkdown" 
                              @bind="bodyMarkdown" 
                              rows="18" 
                              placeholder="# Your Post Title&#10;&#10;Write your content here in Markdown...&#10;&#10;**Bold text**, *italic*, [links](url), etc."
                              required
                              style="background-color: #0a0a0a; border-color: #1f2937; font-size: 0.875rem; line-height: 1.6;"></textarea>
                    <small class="text-muted" style="font-size: 0.75rem;">Supports Markdown formatting</small>
                </div>

                <div class="mb-5">
                    <label for="status" class="form-label">Status <span class="text-danger">*</span></label>
                    <select class="form-select" id="status" @bind="status" style="background-color: #0a0a0a; border-color: #1f2937; padding: 0.65rem 0.85rem;">
                        <option value="Draft">Draft (not visible to public)</option>
                        <option value="Published">Published (visible to everyone)</option>
                    </select>
                </div>

                <hr style="border-color: #1f2937; margin: 2rem 0;" />

                <div class="d-flex gap-3 justify-content-end">
                    <a href="/admin/posts" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-success" style="padding: 0.65rem 2rem;" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Creating...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2"></i>
                            <span>Create Post</span>
                        }
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@code {
    private string title = string.Empty;
    private string slug = string.Empty;
    private string? summary = null;
    private string bodyMarkdown = string.Empty;
    private string status = "Draft";
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isLoading = false;
    private bool slugManuallyEdited = false;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/admin/login");
        }
    }

    private void OnTitleInput(ChangeEventArgs e)
    {
        title = e.Value?.ToString() ?? string.Empty;
        
        // Only auto-generate slug if it hasn't been manually edited
        if (!slugManuallyEdited)
        {
            slug = SlugService.GenerateSlug(title);
        }
    }

    private void OnSlugInput(ChangeEventArgs e)
    {
        slug = e.Value?.ToString() ?? string.Empty;
        // Mark that user has manually edited the slug
        slugManuallyEdited = true;
    }

    private async Task HandleSubmit()
    {
        isLoading = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            var request = new CreatePostRequest(title, slug, summary, bodyMarkdown, status);
            var result = await PostService.CreatePostAsync(request);

            if (result != null)
            {
                successMessage = "Post created successfully!";
                // Redirect after a short delay to show the success message
                await Task.Delay(1000);
                Navigation.NavigateTo("/admin/posts");
            }
            else
            {
                errorMessage = "Failed to create post. Please check your inputs and try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creating post: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}

@page "/p/{slug}"
@using BloggingApp.Web.Services
@using BloggingApp.Web.Models
@inject IPostService PostService
@inject NavigationManager Navigation

@if (loading)
{
    <PageTitle>Loading...</PageTitle>
    <div class="container py-5" style="background-color: #000000; min-height: 80vh;">
        <div class="placeholder-glow">
            <h1 class="placeholder col-8 mb-4" style="background-color: #1f2937;"></h1>
            <div class="placeholder col-4 mb-4" style="background-color: #1f2937;"></div>
            <p class="placeholder col-12" style="background-color: #1f2937;"></p>
            <p class="placeholder col-10" style="background-color: #1f2937;"></p>
            <p class="placeholder col-11" style="background-color: #1f2937;"></p>
            <p class="placeholder col-9" style="background-color: #1f2937;"></p>
        </div>
    </div>
}
else if (post == null)
{
    <PageTitle>Post Not Found</PageTitle>
    <div class="container py-5" style="background-color: #000000; min-height: 80vh;">
        <h1>Post Not Found</h1>
        <p>The post you're looking for doesn't exist.</p>
        <a href="/" class="btn btn-primary">Back to Home</a>
    </div>
}
else
{
    <PageTitle>@post.Title - Danyaal's Blog</PageTitle>
    <div class="container py-5" style="background-color: #000000; min-height: 80vh;">
        <article>
            <header class="mb-4">
                <h1>@post.Title</h1>
                <div class="text-muted">
                    @if (post.PublishedAt.HasValue)
                    {
                        <span>@post.PublishedAt.Value.ToLocalTime().ToString("MMMM dd, yyyy")</span>
                    }
                    <span class="ms-3">@post.ReadingMinutes min read</span>
                </div>
            </header>
            <div class="post-content">
                @((MarkupString)post.BodyHtml)
            </div>
        </article>
        <div class="mt-4">
            <a href="/" class="btn btn-secondary">← Back to Posts</a>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private PostDetailDto? post;
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(Slug))
            return;
            
        loading = true;
        post = await PostService.GetPostBySlugAsync(Slug);
        loading = false;
    }
}

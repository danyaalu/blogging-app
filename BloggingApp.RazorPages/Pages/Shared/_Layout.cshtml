<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Danyaal's Blog</title>
    <link rel="stylesheet" href="~/css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app.css" />
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <!-- Preconnect to API -->
    <link rel="preconnect" href="https://localhost:7218" crossorigin>
    
    <!-- Performance optimizations -->
    <meta name="theme-color" content="#000000" />
    
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="min-vh-100 d-flex flex-column" style="background-color: #000000;">
        <nav class="navbar navbar-expand-lg" style="background-color: #000000; border-bottom: 1px solid #1f2937;">
            <div class="container">
                <a class="navbar-brand" href="/" style="color: #ffffff; font-weight: 300; font-size: 1.25rem;">Home</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" style="border-color: #374151;">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/About" ? "active" : "")" href="/about" style="color: #9ca3af;">
                                About
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        @if (ViewData["IsAuthenticated"] as bool? == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/admin/posts" style="color: #9ca3af;">
                                    <i class="bi bi-pencil-square"></i>  Manage Posts
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/admin/logout" style="color: #9ca3af;">
                                    <i class="bi bi-box-arrow-right"></i>  Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/admin/login" style="color: #9ca3af;">
                                    <i class="bi bi-key"></i>  Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

        <main class="flex-grow-1">
            @RenderBody()
        </main>

        <footer style="background-color: #000000; border-top: 1px solid #1f2937; padding: 2rem 0; margin-top: 3rem;">
            <div class="container text-center" style="color: #6b7280; font-size: 0.875rem;">
                <p class="mb-0">Built with Razor Pages & ASP.NET Core</p>
            </div>
        </footer>
    </div>

    <script src="~/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
